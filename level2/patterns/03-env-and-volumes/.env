# Pattern 03: Environment variables & volumes
#
# Three ways to provide config and model data to containers:
# 1. Env vars: secrets (HF tokens), runtime config
# 2. Named volumes: persisted Hugging Face cache
# 3. Bind mounts: local model files (no download needed)

# Required for gated models (Llama, Mistral, etc.)
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# vLLM runtime config
VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_GPU_MEMORY_UTILIZATION=0.95
VLLM_MAX_MODEL_LEN=8192
