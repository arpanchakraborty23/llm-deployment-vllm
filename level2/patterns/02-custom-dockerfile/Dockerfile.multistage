# =============================================================================
# Stage 1: Builder Stage
# This stage installs all Python dependencies.
# =============================================================================

# Use the official vLLM image as the build environment.
FROM vllm/vllm-openai:latest AS builder

# Set the working directory inside the container.
WORKDIR /app

# Copy only the requirements file first.
# This improves Docker layer caching.
COPY requirements.txt .

# Install all required Python packages.
# --no-cache-dir prevents pip from storing download caches,
# reducing the final image size.
RUN pip install --no-cache-dir -r requirements.txt

# =============================================================================
# Stage 2: Runtime Stage
# This stage contains only the files required to run the application.
# =============================================================================

# Start again from a clean vLLM base image.
FROM vllm/vllm-openai:latest

# Set the working directory.
WORKDIR /app

# Copy all installed Python packages from the builder stage.
COPY --from=builder /usr/local/lib/python3.12/dist-packages \
                    /usr/local/lib/python3.12/dist-packages

# Copy installed executables (if any) from the builder stage.
COPY --from=builder /usr/local/bin \
                    /usr/local/bin

# Copy the rest of the application source code.
COPY . .

# Define the executable that always runs when the container starts.
ENTRYPOINT ["vllm", "serve"]

# Default arguments passed to the ENTRYPOINT.
# These can be overridden when running the container.
CMD ["Qwen/Qwen3-0.6B","--host", "0.0.0.0","--port", "8000"]